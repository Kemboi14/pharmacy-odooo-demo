<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Module Category -->
        <record id="module_category_pharmacy" model="ir.module.category">
            <field name="name">Pharmacy</field>
            <field name="description">Pharmacy Management System</field>
            <field name="sequence">10</field>
        </record>
        
        <!-- Pharmacy User Groups -->
        <record id="group_pharmacy_cashier" model="res.groups">
            <field name="name">Pharmacy: Cashier</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="comment">Can handle POS sales, basic dispensing, and cash management</field>
        </record>
        
        <record id="group_pharmacy_pharmacist" model="res.groups">
            <field name="name">Pharmacy: Pharmacist</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('group_pharmacy_cashier'))]"/>
            <field name="comment">Can handle prescriptions, controlled substances, and clinical operations</field>
        </record>
        
        <record id="group_pharmacy_storekeeper" model="res.groups">
            <field name="name">Pharmacy: Storekeeper</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="comment">Can manage inventory, stock transfers, and expiry tracking</field>
        </record>
        
        <record id="group_pharmacy_accounts" model="res.groups">
            <field name="name">Pharmacy: Accounts</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="comment">Can handle insurance claims, invoicing, and financial reports</field>
        </record>
        
        <record id="group_pharmacy_manager" model="res.groups">
            <field name="name">Pharmacy: Manager</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('group_pharmacy_pharmacist')), 
                                          (4, ref('group_pharmacy_storekeeper')),
                                          (4, ref('group_pharmacy_accounts'))]"/>
            <field name="comment">Can manage all pharmacy operations, reports, and configurations</field>
        </record>
        
        <record id="group_pharmacy_admin" model="res.groups">
            <field name="name">Pharmacy: Administrator</field>
            <field name="category_id" ref="module_category_pharmacy"/>
            <field name="implied_ids" eval="[(4, ref('group_pharmacy_manager'))]"/>
            <field name="comment">Full system administration access</field>
        </record>
        
        <!-- Record Rules for Branch Access Control -->
        
        <!-- Branch-specific rules for cashiers -->
        <record id="pharmacy_pos_order_cashier_rule" model="ir.rule">
            <field name="name">POS Orders: Cashier Branch Access</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="domain_force">[
                ('branch_id', '=', user.branch_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_cashier'))]"/>
        </record>
        
        <record id="pharmacy_patient_cashier_rule" model="ir.rule">
            <field name="name">Patients: Cashier Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_patient"/>
            <field name="domain_force">[
                ('id', '>', 0)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_cashier'))]"/>
        </record>
        
        <record id="pharmacy_prescription_cashier_rule" model="ir.rule">
            <field name="name">Prescriptions: Cashier Branch Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_prescription"/>
            <field name="domain_force">[
                ('branch_id', '=', user.branch_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_cashier'))]"/>
        </record>
        
        <record id="pharmacy_claim_cashier_rule" model="ir.rule">
            <field name="name">Claims: Cashier Branch Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_claim"/>
            <field name="domain_force">[
                ('branch_id', '=', user.branch_id.id)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_cashier'))]"/>
        </record>
        
        <!-- Multi-branch access for managers -->
        <record id="pharmacy_pos_order_manager_rule" model="ir.rule">
            <field name="name">POS Orders: Manager Multi-branch Access</field>
            <field name="model_id" ref="point_of_sale.model_pos_order"/>
            <field name="domain_force">[
                '|',
                    ('branch_id', 'in', user.allowed_branch_ids.ids),
                    ('branch_id', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_manager'))]"/>
        </record>
        
        <record id="pharmacy_branch_manager_rule" model="ir.rule">
            <field name="name">Branches: Manager Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_branch"/>
            <field name="domain_force">[
                '|',
                    ('id', 'in', user.allowed_branch_ids.ids),
                    ('id', '=', False)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_manager'))]"/>
        </record>
        
        <!-- Full access for administrators -->
        <record id="pharmacy_admin_rule" model="ir.rule">
            <field name="name">Pharmacy: Administrator Full Branch Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_branch"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_admin'))]"/>
        </record>
        
        <record id="pharmacy_admin_patient_rule" model="ir.rule">
            <field name="name">Pharmacy: Administrator Full Patient Access</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_patient"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_admin'))]"/>
        </record>
        
        <!-- Stock location access rules -->
        <record id="stock_location_branch_rule" model="ir.rule">
            <field name="name">Stock Locations: Branch Access</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">[
                '|',
                    ('branch_id', '=', False),
                    ('branch_id', 'in', user.allowed_branch_ids.ids)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_cashier')), (4, ref('group_pharmacy_storekeeper'))]"/>
        </record>

        <record id="stock_location_manager_rule" model="ir.rule">
            <field name="name">Stock Locations: Manager Full Access</field>
            <field name="model_id" ref="stock.model_stock_location"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_manager'))]"/>
        </record>
        
        <!-- Controlled substance access restrictions -->
        <record id="controlled_substance_pharmacist_rule" model="ir.rule">
            <field name="name">Controlled Substances: Pharmacist Only</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_controlled_substance_register"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_pharmacist')), (4, ref('group_pharmacy_manager'))]"/>
        </record>
        
        <!-- Insurance claim processing restrictions -->
        <record id="insurance_claim_accounts_rule" model="ir.rule">
            <field name="name">Insurance Claims: Accounts Processing</field>
            <field name="model_id" ref="Pharmacy.model_pharmacy_claim"/>
            <field name="domain_force">[
                '|',
                    ('status', 'in', ['draft', 'submitted']),
                    ('status', 'not in', ['submitted'])
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_accounts'))]"/>
        </record>
        
        <!-- Financial report access restrictions -->
        <record id="financial_report_access_rule" model="ir.rule">
            <field name="name">Financial Reports: Restricted Access</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="domain_force">[
                ('id', '>', 0)
            ]</field>
            <field name="groups" eval="[(4, ref('group_pharmacy_accounts')), (4, ref('group_pharmacy_manager'))]"/>
        </record>
        
    </data>
</odoo>
