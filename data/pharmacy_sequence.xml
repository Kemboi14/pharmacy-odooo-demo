<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Sequences for Pharmacy Management -->
        
        <!-- Branch Code Sequence -->
        <record id="sequence_pharmacy_branch" model="ir.sequence">
            <field name="name">Branch Code</field>
            <field name="code">pharmacy.branch</field>
            <field name="prefix">BR</field>
            <field name="padding">3</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Patient Code Sequence -->
        <record id="sequence_pharmacy_patient" model="ir.sequence">
            <field name="name">Patient Code</field>
            <field name="code">pharmacy.patient</field>
            <field name="prefix">PAT</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Prescription Number Sequence -->
        <record id="sequence_pharmacy_prescription" model="ir.sequence">
            <field name="name">Prescription Number</field>
            <field name="code">pharmacy.prescription</field>
            <field name="prefix">RX</field>
            <field name="padding">8</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Claim Reference Sequence -->
        <record id="sequence_pharmacy_claim" model="ir.sequence">
            <field name="name">Claim Reference</field>
            <field name="code">pharmacy.claim</field>
            <field name="prefix">CLAIM</field>
            <field name="padding">8</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Dispensing Reference Sequence -->
        <record id="sequence_pharmacy_dispensing" model="ir.sequence">
            <field name="name">Dispensing Reference</field>
            <field name="code">pharmacy.dispensing</field>
            <field name="prefix">DISP</field>
            <field name="padding">8</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Cash-up Reference Sequence -->
        <record id="sequence_pharmacy_cashup" model="ir.sequence">
            <field name="name">Cash-up Reference</field>
            <field name="code">pharmacy.cashup</field>
            <field name="prefix">CASHUP</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
        <!-- Promotion Code Sequence -->
        <record id="sequence_pharmacy_promotion" model="ir.sequence">
            <field name="name">Promotion Code</field>
            <field name="code">pharmacy.promotion</field>
            <field name="prefix">PROMO</field>
            <field name="padding">6</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
        
    </data>
</odoo>
