<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        
        <!-- Pharmacy POS Payment Methods -->
        <!-- NOTE: Cash payment methods are created per-POS config in hooks.py -->
        
        <!-- M-Pesa Payment Method -->
        <record id="payment_method_mpesa_pharmacy" model="pos.payment.method">
            <field name="name">M-Pesa</field>
            <field name="receivable_account_id" ref="pharmacy_mpesa_receivable"/>
            <field name="journal_id" ref="pharmacy_mpesa_journal"/>
            <field name="is_cash_count">False</field>
            <field name="split_transactions">True</field>
            <field name="active">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Card Payment Method -->
        <record id="payment_method_card_pharmacy" model="pos.payment.method">
            <field name="name">Card</field>
            <field name="receivable_account_id" ref="pharmacy_card_receivable"/>
            <field name="journal_id" ref="pharmacy_card_journal"/>
            <field name="is_cash_count">False</field>
            <field name="split_transactions">True</field>
            <field name="active">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
        <!-- Insurance Payment Method -->
        <record id="payment_method_insurance_pharmacy" model="pos.payment.method">
            <field name="name">Insurance</field>
            <field name="receivable_account_id" ref="pharmacy_insurance_receivable"/>
            <field name="journal_id" ref="pharmacy_mpesa_journal"/>
            <field name="is_cash_count">False</field>
            <field name="split_transactions">True</field>
            <field name="active">True</field>
            <field name="company_id" ref="base.main_company"/>
        </record>
        
    </data>
</odoo>
