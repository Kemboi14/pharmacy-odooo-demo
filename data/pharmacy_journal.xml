<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Pharmacy-specific Cash Journal -->
        <record id="pharmacy_cash_journal" model="account.journal">
            <field name="name">Pharmacy Cash</field>
            <field name="code">PHC</field>
            <!-- <field name="type">cash</field> -->
            <field name="currency_id" ref="base.KES"/>
        </record>

        <!-- Pharmacy-specific Bank Journal for M-Pesa -->
        <record id="pharmacy_mpesa_journal" model="account.journal">
            <field name="name">Pharmacy M-Pesa</field>
            <field name="code">PMP</field>
            <!-- <field name="type">bank</field> -->
            <field name="currency_id" ref="base.KES"/>
        </record>

        <!-- Pharmacy-specific Card Journal -->
        <record id="pharmacy_card_journal" model="account.journal">
            <field name="name">Pharmacy Card</field>
            <field name="code">PCD</field>
            <!-- <field name="type">bank</field> -->
            <field name="currency_id" ref="base.KES"/>
        </record>
    </data>
</odoo>
