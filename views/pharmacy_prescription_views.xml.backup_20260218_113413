<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Pharmacy Prescription Views -->
        
        <!-- List View -->
        <record id="view_pharmacy_prescription_list" model="ir.ui.view">
            <field name="name">pharmacy.prescription.list</field>
            <field name="model">pharmacy.prescription</field>
            <field name="arch" type="xml">
                <list string="Prescriptions">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="prescriber_name"/>
                    <field name="prescription_date"/>
                    <field name="expiry_date"/>
                    <field name="status" decoration-success="status == 'fully_dispensed'" decoration-info="status == 'partially_dispensed'" decoration-warning="status == 'active'"/>
                </list>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_pharmacy_prescription_form" model="ir.ui.view">
            <field name="name">pharmacy.prescription.form</field>
            <field name="model">pharmacy.prescription</field>
            <field name="arch" type="xml">
                <form string="Prescription">
                    <header>
                        <button name="action_activate" string="Activate" type="object" invisible="status != 'draft'" class="btn-primary"/>
                        <button name="action_cancel" string="Cancel" type="object" invisible="status not in ['draft', 'active']"/>
                        <field name="status" widget="statusbar" statusbar_visible="draft,active,partially_dispensed,fully_dispensed"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Prescription Reference Number *"/>
                            <h1>
                                <field name="name" readonly="1" placeholder="Auto-generated" class="oe_inline"/>
                            </h1>
                        </div>
                        
                        <group name="prescription_header" string="Patient &amp; Prescriber Information" class="mt-4">
                            <group name="patient_info">
                                <field name="patient_id" required="1" options="{'no_create': True}" help="Select the patient for whom this prescription is issued"/>
                                <field name="branch_id" required="1" options="{'no_create': True}" help="Branch where prescription was issued"/>
                                <field name="prescription_date" required="1" help="Date prescription was written"/>
                            </group>
                            <group name="prescriber_info">
                                <field name="prescriber_name" required="1" placeholder="e.g. Dr. John Smith" help="Full name of prescribing doctor"/>
                                <field name="prescriber_license" placeholder="e.g. MD-12345" help="Medical license number"/>
                                <field name="prescriber_phone" widget="phone" placeholder="e.g. +254712345678" help="Contact phone of prescriber"/>
                            </group>
                        </group>
                        
                        <group name="prescription_validity" string="Prescription Validity Period">
                            <group name="validity_details">
                                <field name="validity_days" required="1" help="How many days this prescription remains valid"/>
                                <field name="expiry_date" readonly="1" help="Auto-calculated expiry date"/>
                            </group>
                            <group name="clinical_info">
                                <field name="diagnosis" placeholder="e.g. Type 2 Diabetes, Hypertension" help="Clinical diagnosis or reason for prescription"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Prescribed Medications">
                                <group class="alert alert-info mt-2">
                                    <p style="font-size: 12px;">
                                        Add medications prescribed by doctor. System tracks what was dispensed and what remains.
                                    </p>
                                </group>
                                <field name="line_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="product_id" required="1" help="Medicine/product being prescribed"/>
                                        <field name="quantity_prescribed" required="1" help="Quantity prescribed by doctor"/>
                                        <field name="quantity_dispensed" readonly="1" help="Total dispensed so far"/>
                                        <field name="quantity_remaining" readonly="1" help="Still available to dispense"/>
                                        <field name="dosage_instructions" placeholder="e.g. Take with food" help="How to take medication"/>
                                        <field name="frequency" placeholder="e.g. Twice daily" required="1" help="How often to take"/>
                                        <field name="duration_days" placeholder="e.g. 7" required="1" help="How many days to take"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Dispensing History">
                                <group class="alert alert-success mt-2">
                                    <p style="font-size: 12px;">
                                        View-only list of all medications already dispensed from this prescription.
                                    </p>
                                </group>
                                <field name="dispensing_ids" readonly="1" nolabel="1">
                                    <list>
                                        <field name="name" decoration-success="verified_by"/>
                                        <field name="dispensed_date"/>
                                        <field name="dispensed_by"/>
                                        <field name="quantity" decoration-success="verified_by"/>
                                    </list>
                                </field>
                            </page>
                            
                            <page string="Additional Notes">
                                <field name="notes" placeholder="e.g. Patient allergies, special instructions, follow-up required" nolabel="1"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Search View -->
        <record id="view_pharmacy_prescription_search" model="ir.ui.view">
            <field name="name">pharmacy.prescription.search</field>
            <field name="model">pharmacy.prescription</field>
            <field name="arch" type="xml">
                <search string="Search Prescriptions">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="prescriber_name"/>
                    <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                    <filter string="Active" name="active" domain="[('status', '=', 'active')]"/>
                    <filter string="Partially Dispensed" name="partially_dispensed" domain="[('status', '=', 'partially_dispensed')]"/>
                    <filter string="Fully Dispensed" name="fully_dispensed" domain="[('status', '=', 'fully_dispensed')]"/>
                    <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                    <separator/>
                    <filter string="Valid" name="valid" domain="[('expiry_date', '&gt;=', context_today())]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                        <filter string="Prescriber" name="group_prescriber" context="{'group_by': 'prescriber_name'}"/>
                        <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_pharmacy_prescription" model="ir.actions.act_window">
            <field name="name">Prescriptions</field>
            <field name="res_model">pharmacy.prescription</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No prescriptions yet
                </p>
                <p>
                    Prescriptions are created when doctors prescribe medication to patients.
                    Track prescription status and dispensing history here.
                </p>
            </field>
        </record>
        
        <!-- Pharmacy Dispensing Views -->
        
        <!-- List View -->
        <record id="view_pharmacy_dispensing_list" model="ir.ui.view">
            <field name="name">pharmacy.dispensing.list</field>
            <field name="model">pharmacy.dispensing</field>
            <field name="arch" type="xml">
                <list string="Dispensing Records">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="prescription_id"/>
                    <field name="product_id"/>
                    <field name="quantity"/>
                    <field name="dispensed_date"/>
                    <field name="dispensed_by"/>
                </list>
            </field>
        </record>
        
        <!-- Form View -->
        <record id="view_pharmacy_dispensing_form" model="ir.ui.view">
            <field name="name">pharmacy.dispensing.form</field>
            <field name="model">pharmacy.dispensing</field>
            <field name="arch" type="xml">
                <form string="Dispensing Record">
                    <header>
                        <button name="action_verify" string="Verify" type="object" invisible="verified_by" class="btn-primary"/>
                        <button name="action_print_label" string="Print Label" type="object"/>
                    </header>
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Dispensing Record Number"/>
                            <h1>
                                <field name="name" readonly="1" placeholder="Auto-generated"/>
                            </h1>
                        </div>
                        
                        <group name="dispensing_main" string="Dispensing Details" class="mt-4">
                            <group name="dispensing_links">
                                <field name="patient_id" readonly="1" help="Patient receiving the medication"/>
                                <field name="prescription_id" readonly="1" help="Prescription this dispense relates to"/>
                                <field name="product_id" readonly="1" help="Medication being dispensed"/>
                                <field name="lot_id" readonly="1" help="Batch/lot of medication"/>
                                <field name="quantity" readonly="1" help="Amount dispensed"/>
                            </group>
                            <group name="dispensing_meta">
                                <field name="branch_id" readonly="1" help="Branch where dispensed"/>
                                <field name="dispensed_date" readonly="1" help="When medication was dispensed"/>
                                <field name="dispensed_by" readonly="1" help="Pharmacist who dispensed"/>
                                <field name="verified_by" readonly="1" decoration-success="verified_by" help="Verification pharmacist"/>
                                <field name="verified_date" readonly="1" decoration-success="verified_by" help="Verification date"/>
                            </group>
                        </group>
                        
                        <group name="dispensing_context" string="Transaction Links" class="mt-2">
                            <group>
                                <field name="pos_order_id" readonly="1" help="POS order if sold through pharmacy counter"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Dosage Instructions">
                                <group class="alert alert-info mt-2">
                                    <p style="font-size: 12px;">
                                        Clear instructions for patient on how to use this medication.
                                    </p>
                                </group>
                                <field name="dosage_instructions" nolabel="1" placeholder="e.g. Take 1 tablet twice daily with food. Do not exceed 4 tablets per day."/>
                            </page>
                            <page string="Dispensing Notes">
                                <field name="notes" nolabel="1" placeholder="e.g. Patient counseled on side effects, refill status, interactions with other medications"/>
                            </page>
                        </notebook>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="message_ids"/>
                    </div>
                </form>
            </field>
        </record>
        
        <!-- Search View -->
        <record id="view_pharmacy_dispensing_search" model="ir.ui.view">
            <field name="name">pharmacy.dispensing.search</field>
            <field name="model">pharmacy.dispensing</field>
            <field name="arch" type="xml">
                <search string="Search Dispensing Records">
                    <field name="name"/>
                    <field name="patient_id"/>
                    <field name="dispensed_by"/>
                    <separator/>
                    <filter string="Today" name="today" domain="[('dispensed_date', '&gt;=', context_today())]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Pharmacist" name="group_pharmacist" context="{'group_by': 'dispensed_by'}"/>
                        <filter string="Date" name="group_date" context="{'group_by': 'dispensed_date'}"/>
                        <filter string="Branch" name="group_branch" context="{'group_by': 'branch_id'}"/>
                    </group>
                </search>
            </field>
        </record>
        
        <!-- Action -->
        <record id="action_pharmacy_dispensing" model="ir.actions.act_window">
            <field name="name">Dispensing Records</field>
            <field name="res_model">pharmacy.dispensing</field>
            <field name="view_mode">list,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No dispensing records yet
                </p>
                <p>
                    Dispensing records are automatically created when you dispense medication in POS.
                    Track all dispensing activities here.
                </p>
            </field>
        </record>
        
        <!-- Menu Items -->
        <menuitem id="menu_pharmacy_prescription" 
                  name="Prescriptions" 
                  parent="menu_pharmacy_operations" 
                  action="action_pharmacy_prescription" 
                  sequence="10"/>
        
        <menuitem id="menu_pharmacy_dispensing" 
                  name="Dispensing Records" 
                  parent="menu_pharmacy_operations" 
                  action="action_pharmacy_dispensing" 
                  sequence="20"/>
        
    </data>
</odoo>
