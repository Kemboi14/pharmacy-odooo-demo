<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Coverage Rule Views -->
    
    <!-- List View -->
    <record id="view_pharmacy_coverage_rule_list" model="ir.ui.view">
        <field name="name">pharmacy.coverage.rule.list</field>
        <field name="model">pharmacy.coverage.rule</field>
        <field name="arch" type="xml">
            <list string="Coverage Rules">
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <field name="coverage_percentage" widget="percentage"/>
                <field name="copay_percentage" widget="percentage"/>
                <field name="is_exclusion"/>
                <field name="active"/>
            </list>
        </field>
    </record>
    
    <!-- Form View -->
    <record id="view_pharmacy_coverage_rule_form" model="ir.ui.view">
        <field name="name">pharmacy.coverage.rule.form</field>
        <field name="model">pharmacy.coverage.rule</field>
        <field name="arch" type="xml">
            <form string="Insurance Coverage Rule">
                <header>
                    <field name="active" widget="boolean_toggle"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="plan_id" string="Insurance Plan *"/>
                        <h1>
                            <field name="plan_id" required="1" options="{'no_create': True}" help="Insurance plan this rule applies to"/>
                        </h1>
                        <label for="name" string="Rule Description"/>
                        <p>
                            <field name="name" placeholder="e.g. Generic Drug Coverage, Exclusion List" class="oe_inline"/>
                        </p>
                    </div>
                    
                    <group name="rule_scope" string="Rule Scope &amp; Applicability">
                        <group name="product_scope">
                            <field name="product_id" placeholder="e.g. Aspirin 100mg" options="{'no_create': True}" help="Specific product this rule applies to (leave empty for category-based rule)"/>
                            <field name="category_id" placeholder="e.g. Pain Relief, Antibiotics" options="{'no_create': True}" help="Product category this rule applies to"/>
                            <field name="is_exclusion" widget="boolean_toggle" help="Check if this rule excludes items from coverage"/>
                        </group>
                        <group name="rule_settings">
                            <field name="priority" placeholder="1 = Highest" help="Higher priority rules are evaluated first (1=highest)"/>
                            <field name="branch_ids" widget="many2many_tags" help="Leave empty to apply to all branches"/>
                        </group>
                    </group>
                    
                    <group name="coverage_financial" string="Coverage &amp; Cost Sharing">
                        <group name="insurance_coverage">
                            <field name="coverage_percentage" required="1" widget="percentage" help="Percentage covered by insurance (e.g., 80 = 80% coverage)"/>
                            <field name="copay_percentage" widget="percentage" help="Patient co-payment as percentage of drug cost"/>
                            <field name="copay_amount" help="Fixed co-payment amount (overrides percentage if set)"/>
                        </group>
                        <group name="coverage_limits">
                            <field name="max_quantity_per_visit" help="Maximum quantity per patient visit"/>
                            <field name="max_quantity_per_month" help="Maximum quantity per patient per month"/>
                            <field name="max_amount_per_claim" help="Maximum claim amount per submission"/>
                        </group>
                    </group>
                    
                    <notebook>
                        <page string="Clinical Requirements" name="clinical">
                            <group string="Prescription Requirements">
                                <group>
                                    <field name="require_prescription" widget="boolean_toggle" help="Prescription required for coverage"/>
                                    <field name="require_generic_substitution" widget="boolean_toggle" help="Generic substitution required when available"/>
                                    <field name="require_preauth" widget="boolean_toggle" help="Pre-authorization required"/>
                                </group>
                                <group>
                                    <field name="preauth_threshold" help="Pre-auth required above this amount"/>
                                    <field name="valid_prescriber_types" placeholder="e.g. MD, DO, NP" help="Allowed prescriber credentials"/>
                                </group>
                            </group>
                        </page>
                        
                        <page string="Exclusion Details" name="exclusion" invisible="not is_exclusion">
                            <group string="Exclusion Reason">
                                <field name="exclusion_reason" nolabel="1" placeholder="Explain why this item is excluded from coverage (e.g., Cosmetic, Over-the-counter, Experimental)"/>
                            </group>
                        </page>
                        
                        <page string="Rule Conditions" name="conditions">
                            <group string="Advanced Conditions">
                                <group>
                                    <field name="age_min" help="Minimum patient age for this rule"/>
                                    <field name="age_max" help="Maximum patient age for this rule"/>
                                    <field name="gender" help="Apply rule only to specific gender"/>
                                </group>
                                <group>
                                    <field name="diagnosis_codes" placeholder="ICD-10 codes" help="Required diagnosis codes for coverage"/>
                                    <field name="notes" nolabel="1" placeholder="Additional conditions or special notes for this rule..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    
    <!-- Search View -->
    <record id="view_pharmacy_coverage_rule_search" model="ir.ui.view">
        <field name="name">pharmacy.coverage.rule.search</field>
        <field name="model">pharmacy.coverage.rule</field>
        <field name="arch" type="xml">
            <search string="Coverage Rules">
                <field name="plan_id"/>
                <field name="product_id"/>
                <field name="category_id"/>
                <filter string="Active" name="active" domain="[('active', '=', True)]"/>
                <filter string="Exclusions" name="exclusions" domain="[('is_exclusion', '=', True)]"/>
                <separator/>
                <filter string="Product Rules" name="product_rules" domain="[('product_id', '!=', False)]"/>
                <filter string="Category Rules" name="category_rules" domain="[('category_id', '!=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Product" name="group_product" context="{'group_by': 'product_id'}"/>
                    <filter string="Category" name="group_category" context="{'group_by': 'category_id'}"/>
                </group>
            </search>
        </field>
    </record>
    
    <!-- Action -->
    <record id="action_pharmacy_coverage_rule" model="ir.actions.act_window">
        <field name="name">Coverage Rules</field>
        <field name="res_model">pharmacy.coverage.rule</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create coverage rules for insurance plans
            </p>
            <p>
                Coverage rules define how insurance plans cover specific products or categories.
                You can set coverage percentages, co-pay amounts, and quantity limits.
            </p>
        </field>
    </record>
              
</odoo>
