<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        
        <!-- Stock Lot List View -->
        <record id="view_pharmacy_lot_list" model="ir.ui.view">
            <field name="name">stock.lot.pharmacy.list</field>
            <field name="model">stock.lot</field>
            <field name="arch" type="xml">
                <list string="Batches/Lots">
                    <field name="name" decoration-danger="expiry_date &lt; current_date" decoration-warning="expiry_date &lt;= (context_today() + relativedelta(months=3)).strftime('%Y-%m-%d')"/>
                    <field name="product_id"/>
                    <field name="company_id"/>
                    <field name="ref" help="Batch reference or lot number"/>
                    <field name="expiry_date" decoration-danger="expiry_date &lt; current_date" decoration-warning="expiry_date &lt;= (context_today() + relativedelta(months=3)).strftime('%Y-%m-%d')"/>
                    <field name="product_qty" decoration-warning="product_qty &lt; 10"/>
                </list>
            </field>
        </record>
        
        <!-- Inherit Stock Lot Form View to add Pharmacy Information -->
        <!-- Temporarily commented out to avoid inheritance issues -->
